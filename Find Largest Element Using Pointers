#include <stdio.h>

int main() {
    int a[100], n, i;
    int *ptr;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    ptr = a;  // pointer to array

    int max = *ptr;

    for (i = 1; i < n; i++) {
        if (*(ptr + i) > max)
            max = *(ptr + i);
    }

    printf("Largest element = %d", max);

    return 0;
}
